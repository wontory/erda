{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "sortImports": {
    "groups": ["builtin", "external", ["subpath", "internal"], ["parent", "sibling", "index"], "style", "unknown"]
  },
  "sortTailwindcss": {
    "stylesheet": "./packages/ui/src/styles.css",
    "functions": ["cn", "cva"]
  },
  "sortPackageJson": true,
  "ignorePatterns": [
    "packages/api/src/generated/**",
    "packages/api/openapi.yaml",
    "packages/api/specs/**",
    "packages/core/src/simulators/data/potential-tables.ts",
    "apps/desktop/src-tauri/gen/**",
    "apps/desktop/src-tauri/permissions/autogenerated/**",
    "pnpm-lock.yaml",
    "target/**",
    "**/dist/**"
  ]
}
