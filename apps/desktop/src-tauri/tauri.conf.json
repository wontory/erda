{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Erda",
  "version": "0.1.1",
  "identifier": "com.wontory.erda",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "Erda",
        "width": 400,
        "height": 640,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "inspector",
        "url": "inspector.html",
        "title": "Erda 상세",
        "width": 320,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "sheet",
        "url": "sheet.html",
        "title": "Erda 설정",
        "width": 360,
        "height": 400,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "hud",
        "url": "hud.html",
        "title": "Erda HUD",
        "width": 400,
        "height": 90,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.nexon.com; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" },
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBNDVGRDE0RkZFMjg0OEEKUldTS2hPTC9GUDFGNnV2N1lQNnd4YU9KSWNyLzJwNjZqcjZkMHJjc3F5VDBLb3JINDNYOVA1c0QK",
      "endpoints": ["https://github.com/wontory/erda-releases/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
