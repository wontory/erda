{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "settings window",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:app:allow-version",
    "store:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://maplestory.nexon.com/*" }, { "url": "https://openapi.nexon.com/*" }]
    },
    "os:default",
    "updater:default",
    "process:allow-restart",
    "autostart:default",
    "process:allow-exit",
    "log:default",
    "allow-nexon-request",
    "allow-nexon-character-look",
    "allow-nexon-calls-today",
    "allow-nexon-cache-size",
    "allow-nexon-cache-clear",
    "allow-sound-preview"
  ]
}
